{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "vite/client"
    ],
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ]
}